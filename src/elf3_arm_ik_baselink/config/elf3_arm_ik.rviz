Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 0.1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 160
      Enabled: true
      Name: Grid
    - Class: rviz_default_plugins/RobotModel
      Description Topic:
        Value: /robot_description
      Enabled: true
      Name: ELF3 Robot
      Visual Enabled: true
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Topic:
        Value: /arm_ik/demo_text
      Name: Demo Status Text
      Namespaces:
        demo_status: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Topic:
        Value: /arm_ik/reachability_markers
      Name: Right Arm Reachability
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: torso_link
    Frame Rate: 20
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 2.2
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Pitch: 0.45
      Yaw: 0.75
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1200
